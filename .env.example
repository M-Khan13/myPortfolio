# GitHub personal access token used to fetch the contribution calendar.
#
# The calendar is only available through GitHub's GraphQL API, which requires
# authentication. A classic token with NO scopes selected is enough for public
# contribution data — do not grant repo or write scopes.
#
# Create one at: https://github.com/settings/tokens
#
# Read server-side only (src/lib/github.ts is marked `server-only`), so it is
# never sent to the browser. Leave it unset and the graph renders an empty grid
# with an explanatory note instead of crashing.
GITHUB_TOKEN=

# Web3Forms access key for the contact form.
#
# Create a key at https://web3forms.com by entering the delivery address —
# messages from this site go to farzankhan1800@gmail.com.
#
# Read server-side only, in src/app/api/contact/route.ts: the browser posts to
# that route and the route forwards to Web3Forms, so the key never ships in the
# client bundle. Do NOT prefix it with NEXT_PUBLIC_. Leave it unset and the form
# renders but replies with a "not configured yet" notice instead of sending.
WEB3FORMS_KEY=
